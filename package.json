{
  "name": "vellum",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI assistant with adaptive planning and delegation",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "dev": "node scripts/dev.mjs",
    "dev:core": "pnpm -F @vellum/core dev",
    "dev:cli": "pnpm -F @butlerw/vellum dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rimraf node_modules",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "personal-assistant"
  ],
  "author": "Vellum Team",
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
