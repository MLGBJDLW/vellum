{
  "name": "@vellum/lsp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./config-schema": {
      "types": "./dist/config-schema.d.ts",
      "import": "./dist/config-schema.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/config.ts src/config-schema.ts --format esm && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts src/config.ts src/config-schema.ts --format esm --watch src --onSuccess \"tsc -p tsconfig.build.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "lru-cache": "^11.5.3",
    "nanoid": "^6.0.2",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
