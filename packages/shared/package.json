{
  "name": "@vellum/shared",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm --watch src --onSuccess \"tsc -p tsconfig.build.json\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  }
}
