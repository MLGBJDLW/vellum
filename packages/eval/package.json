{
  "name": "@vellum/eval",
  "version": "0.1.3",
  "private": true,
  "description": "Agent evaluation framework for Vellum CLI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vellum/core": "workspace:*",
    "@vellum/provider": "workspace:*",
    "@vellum/shared": "workspace:*",
    "glob": "^14.0.3",
    "jest-diff": "^30.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ]
}
