{
  "name": "@vellum/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsup src/index.ts --format esm && tsc -p tsconfig.build.json",
    "postbuild": "node -e \"const fs=require('fs');const p=require('path');fs.cpSync(p.join('src','prompts','markdown'),p.join('dist','markdown'),{recursive:true})\"",
    "dev": "tsup src/index.ts --format esm --watch src --onSuccess \"tsc -p tsconfig.build.json\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@vellum/lsp": "workspace:*",
    "@vellum/provider": "workspace:*",
    "@vellum/sandbox": "workspace:*",
    "@vellum/shared": "workspace:*",
    "chokidar": "^6.0.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.14",
    "js-yaml": "^5.5.0",
    "keytar": "^7.9.0",
    "minisearch": "^7.2.0",
    "nanoid": "^6.0.2",
    "picomatch": "^4.0.7",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7",
    "@opentelemetry/sdk-trace": "^3.0.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/iarna__toml": "^2.0.5",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "comments": {
    "keytar-bun-compat": "keytar uses native Node-API bindings. For Bun: ensure node-gyp build tools are available. May require --backend=node flag in some Bun versions."
  }
}
