{
  "name": "@butlerw/vellum",
  "version": "0.5.2",
  "description": "Personal AI assistant for the terminal",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "bin": {
    "vellum": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.tsx --banner",
    "start": "node dist/index.mjs",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@inquirer/prompts": "^8.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^6.0.1",
    "clipboardy": "^5.3.2",
    "commander": "^15.0.0",
    "fuzzysort": "^4.0.2",
    "gray-matter": "^4.0.3",
    "ink": "npm:@jrichman/ink@7.1.0",
    "ink-gradient": "^4.0.1",
    "ink-spinner": "^5.0.0",
    "marked": "^18.1.2",
    "open": "^11.0.4",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "shiki": "^4.5.0",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0",
    "table": "^6.9.0",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@vellum/core": "workspace:*",
    "@vellum/eval": "workspace:*",
    "@vellum/lsp": "workspace:*",
    "@vellum/mcp": "workspace:*",
    "@vellum/plugin": "workspace:*",
    "@vellum/provider": "workspace:*",
    "@vellum/sandbox": "workspace:*",
    "@vellum/shared": "workspace:*",
    "ink-testing-library": "^4.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  }
}
